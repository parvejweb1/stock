# Indian Brokers Environment Variables Example (trader-broker)
# Set these in PowerShell ($env:VAR="...") or Windows User Environment Variables.
# NEVER paste API keys, secrets, MPINs, TOTP seeds, or access tokens in chat or commit them to files.

# 1. Groww (growwapi)
$env:GROWW_ACCESS_TOKEN = "your_groww_jwt_access_token_here"
# Or generate via API key + secret/TOTP:
# $env:GROWW_API_KEY = "your_groww_api_key"
# $env:GROWW_API_SECRET = "your_groww_api_secret"
# $env:GROWW_TOTP_SECRET = "your_groww_totp_base32_secret"

# 2. Zerodha Kite Connect (kiteconnect) — requires daily login access token
$env:KITE_API_KEY = "your_kite_api_key"
$env:KITE_ACCESS_TOKEN = "your_daily_kite_access_token"

# 3. Upstox API v2 (upstox_client) — requires daily OAuth access token
$env:UPSTOX_ACCESS_TOKEN = "your_daily_upstox_access_token"

# 4. Angel One SmartAPI (SmartApi + pyotp)
$env:ANGEL_API_KEY = "your_angel_smartapi_trading_key"
$env:ANGEL_CLIENT_ID = "your_angel_client_code"
$env:ANGEL_PIN = "your_angel_mpin"
$env:ANGEL_TOTP_SECRET = "your_angel_totp_base32_seed"
